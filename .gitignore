# ============================================================
# cache_arch .gitignore
# ============================================================
# Goal:
# - Track source code, configs, docs, notebooks, small summaries, and curated result tables/figures.
# - Ignore local ChampSim clones/builds, large raw dumps, logs, caches, and temporary experiment outputs.
# - Allow Colab upload split files to be tracked when intentionally added.
# - Keep raw traces local unless they are intentionally handled by git-lfs or external storage.

# ------------------------------------------------------------
# OS / editor
# ------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
.vscode/
.idea/
*.swp
*.swo
*~

# ------------------------------------------------------------
# Python / notebook local state
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local Python environments
.venv/
venv/
env/
ENV/
conda-env/

# ------------------------------------------------------------
# Local dependency clones / submodule working trees
# ------------------------------------------------------------
ChampSim/
ChampSim-ML/

# external submodules: keep only submodule pointers / explicitly tracked files.
external/*
!external/ChampSim/
!external/ChampSim-ML/
!external/README.md
!external/.gitkeep

# ------------------------------------------------------------
# ChampSim / simulator build outputs
# ------------------------------------------------------------
bin/
obj/
build/
build_*/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
compile_commands.json
*.out
*.exe
*.o
*.a
*.so
*.dylib
*.gcda
*.gcno

# ------------------------------------------------------------
# Trace files
# ------------------------------------------------------------
# ChampSim traces are usually too large for normal GitHub commits.
# Keep them local or use git-lfs/external storage.
traces/
**/traces/
*.champsimtrace
*.champsimtrace.xz
*.trace
*.trace.xz
*.trace.gz
*.xz

# ------------------------------------------------------------
# Large raw dumps from trace/candidate logging.
# ------------------------------------------------------------
access_trace*.csv
**/access_trace*.csv
candidate_trace*.csv
**/candidate_trace*.csv
shadow_candidate*.csv
**/shadow_candidate*.csv
shadow_candidates*.csv
**/shadow_candidates*.csv
*.sqlite
*.sqlite3
*.db

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------
*.log
logs/
**/logs/

# Accidentally copied root-level generated summary. Use the curated path under
# formal_NN_training/results/final_tables/ instead.
/accuracy_compare_all_traces.csv

# ------------------------------------------------------------
# Generated experiment outputs
# ------------------------------------------------------------
results/tmp/*
!results/tmp/.gitkeep
results/raw/*
!results/raw/.gitkeep
results/logs/*
!results/logs/.gitkeep
results/generated/*
!results/generated/.gitkeep
!results/generated/prefetch_lists/
results/generated/prefetch_lists/*
!results/generated/prefetch_lists/.gitkeep

projects/legacy_gru_prefetch/results/tmp/*
!projects/legacy_gru_prefetch/results/tmp/.gitkeep
projects/legacy_gru_prefetch/results/raw/*
!projects/legacy_gru_prefetch/results/raw/.gitkeep
projects/legacy_gru_prefetch/results/logs/*
!projects/legacy_gru_prefetch/results/logs/.gitkeep
projects/legacy_gru_prefetch/results/generated/*
!projects/legacy_gru_prefetch/results/generated/.gitkeep
!projects/legacy_gru_prefetch/results/generated/prefetch_lists/
projects/legacy_gru_prefetch/results/generated/prefetch_lists/*
!projects/legacy_gru_prefetch/results/generated/prefetch_lists/.gitkeep

# ------------------------------------------------------------
# Formal LSTM/SPP local/generated outputs
# ------------------------------------------------------------
# Raw generated event CSVs stay local.
formal_NN_training/data/generated/

# Colab upload splits are allowed when intentionally added, because Colab can pull
# these directly from GitHub. Raw generated CSVs stay ignored.
formal_NN_training/data/upload/*
!formal_NN_training/data/upload/*/
!formal_NN_training/data/upload/*/lstm_events_*.csv.gz.part_*
!formal_NN_training/data/upload/*/candidate_table_*.csv.gz.part_*
!formal_NN_training/data/upload/*/spp_events_*.csv.gz.part_*
!formal_NN_training/data/upload/*.csv.gz

# Generated action/model/evaluation artifacts. Keep these local; they can be huge
# and are usually recreated from Colab/cluster runs.
formal_NN_training/artifacts/*.csv
formal_NN_training/artifacts/*.json
formal_NN_training/artifacts/*.pt
formal_NN_training/artifacts/*.pth
formal_NN_training/artifacts/*.gz
formal_NN_training/artifacts/full_lstm_cache_actions*
formal_NN_training/artifacts/recall_lstm_*.csv
formal_NN_training/artifacts/recall_lstm_*.json
formal_NN_training/artifacts/by_trace/
formal_NN_training/artifacts/packed/

# Ignore most generated result content, but allow curated final tables/figures.
formal_NN_training/results/*
!formal_NN_training/results/.gitkeep
!formal_NN_training/results/final_tables/
formal_NN_training/results/final_tables/*
!formal_NN_training/results/final_tables/*.csv
!formal_NN_training/results/final_tables/*.svg
!formal_NN_training/results/capacity_sweep/
formal_NN_training/results/capacity_sweep/*
!formal_NN_training/results/capacity_sweep/*.csv
!formal_NN_training/results/capacity_sweep/*.svg

# Local helper scripts created during debugging. Canonical reusable scripts should
# be named with a numeric prefix instead of local_*.
formal_NN_training/scripts/local_*.py
formal_NN_training/scripts/local_*.sh

# Capacity temp configs.
formal_NN_training/_cfg/

# Top-level generated text/list artifacts.
results/*.txt
projects/legacy_gru_prefetch/results/*.txt
prefetch_list*.txt
**/prefetch_list*.txt
colab_prefetch_result/prefetch_list*.txt

# Post-prefetch-filter generated data/model artifacts.
projects/post_prefetch_filter/results/*
projects/post_prefetch_filter/data/raw/
projects/post_prefetch_filter/models/
projects/post_prefetch_filter/checkpoints/
projects/post_prefetch_filter/runs/
projects/post_prefetch_filter/wandb/
projects/post_prefetch_filter/data/generated/*

# But allow curated Colab feature-sweep summaries and compressed active notebook input.
!projects/post_prefetch_filter/results/
!projects/post_prefetch_filter/results/colab_feature_sweeps/
!projects/post_prefetch_filter/results/colab_feature_sweeps/**
!projects/post_prefetch_filter/data/
!projects/post_prefetch_filter/data/generated/
!projects/post_prefetch_filter/data/generated/.gitkeep
!projects/post_prefetch_filter/data/generated/spp_candidate_log.csv.xz
!projects/post_prefetch_filter/data/generated/spp_candidate_log.csv.gz
!projects/post_prefetch_filter/data/generated/README.md

# ML training artifacts anywhere in the repo.
checkpoints/
**/checkpoints/
runs/
**/runs/
wandb/
**/wandb/
*.pt
*.pth
*.ckpt
*.onnx

# ------------------------------------------------------------
# Keep small summaries/artifacts that are useful to commit intentionally
# ------------------------------------------------------------
!results/README.md
!results/baseline.csv
!results/upper_bound.csv
!results/bypass_summary.csv
!results/mlp_demo_summary.csv
!results/nn_demo_summary.csv
!results/gru_sweep_summary.csv
!results/gru_v9_decode_sweep_ipc.csv
!results/gru_v9_decode_sweep_gcc_s-734B.csv
!results/gru_v8_summary.json
!results/gru_v9_summary_*.json
!results/slide8_data.tex

!projects/legacy_gru_prefetch/results/README.md
!projects/legacy_gru_prefetch/results/baseline.csv
!projects/legacy_gru_prefetch/results/upper_bound.csv
!projects/legacy_gru_prefetch/results/bypass_summary.csv
!projects/legacy_gru_prefetch/results/mlp_demo_summary.csv
