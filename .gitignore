# dependencies
# Old top-level local clones; new layout uses external/ submodules.
ChampSim/
ChampSim-ML/

# external submodules: keep only submodule pointers tracked
external/*
!external/ChampSim/
!external/ChampSim-ML/

# traces and huge simulator dumps
traces/
*.champsimtrace.xz
results/access_trace*.csv
results/traces/

# generated logs
*.log
results/logs/
results/mlp_demo/*.log

# generated experiment outputs that are usually local-only
results/tmp/
results/raw/
results/generated/
results/*.txt
prefetch_list*.txt
colab_prefetch_result/prefetch_list*.txt

# keep small summary/artifact files that are useful to commit intentionally
!results/README.md
!results/baseline.csv
!results/upper_bound.csv
!results/bypass_summary.csv
!results/mlp_demo_summary.csv
!results/nn_demo_summary.csv
!results/gru_sweep_summary.csv
!results/slide8_data.tex
!results/gru_v8_summary.json

# tracked experiment configs
!configs/
!configs/**

# python
__pycache__/
*.pyc
.ipynb_checkpoints/

# editor
.vscode/
.DS_Store
