# ============================================================
# cache_arch .gitignore
# ============================================================
# Goal:
# - Track source code, configs, docs, notebooks, small summaries, and curated result tables/figures.
# - Ignore local ChampSim clones/builds, large raw dumps, logs, caches, and temporary experiment outputs.
# - Allow Colab upload split files to be tracked when intentionally added.
# - Keep raw traces local unless they are intentionally handled by git-lfs or external storage.

# ------------------------------------------------------------
# OS / editor
# ------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
.vscode/
.idea/
*.swp
*.swo
*~

# ------------------------------------------------------------
# Python / notebook local state
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local Python environments
.venv/
venv/
env/
ENV/
conda-env/

# ------------------------------------------------------------
# Local dependency clones / submodule working trees
# ------------------------------------------------------------
ChampSim/
ChampSim-ML/

# external submodules: keep only submodule pointers / explicitly tracked files.
external/*
!external/ChampSim/
!external/ChampSim-ML/
!external/README.md
!external/.gitkeep

# ------------------------------------------------------------
# ChampSim / simulator build outputs
# ------------------------------------------------------------
bin/
obj/
build/
build_*/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
compile_commands.json
*.out
*.exe
*.o
*.a
*.so
*.dylib
*.gcda
*.gcno

# ------------------------------------------------------------
# Trace files
# ------------------------------------------------------------
# ChampSim traces are usually too large for normal GitHub commits.
# Keep them local or use git-lfs/external storage.
traces/
**/traces/
*.champsimtrace
*.champsimtrace.xz
*.trace
*.trace.xz
*.trace.gz
*.xz

# ------------------------------------------------------------
# Large raw dumps from trace/candidate logging.
# ------------------------------------------------------------
access_trace*.csv
**/access_trace*.csv
candidate_trace*.csv
**/candidate_trace*.csv
shadow_candidate*.csv
**/shadow_candidate*.csv
shadow_candidates*.csv
**/shadow_candidates*.csv
*.sqlite
*.sqlite3
*.db

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------
*.log
logs/
**/logs/

# Accidentally copied root-level generated summary. Use the curated path under
# formal_NN_training/results/final_tables/ instead.
/accuracy_compare_all_traces.csv

# ------------------------------------------------------------
# Generated experiment outputs
# ------------------------------------------------------------
results/tmp/*
!results/tmp/.gitkeep
results/raw/*
!results/raw/.gitkeep
results/logs/*
!results/logs/.gitkeep
results/generated/*
!results/generated/.gitkeep
!results/generated/prefetch_lists/
results/generated/prefetch_lists/*
!results/generated/prefetch_lists/.gitkeep

projects/legacy_gru_prefetch/results/tmp/*
!projects/legacy_gru_prefetch/results/tmp/.gitkeep
projects/legacy_gru_prefetch/results/raw/*
!projects/legacy_gru_prefetch/results/raw/.gitkeep
projects/legacy_gru_prefetch/results/logs/*
!projects/legacy_gru_prefetch/results/logs/.gitkeep
projects/legacy_gru_prefetch/results/generated/*
!projects/legacy_gru_prefetch/results/generated/.gitkeep
!projects/legacy_gru_prefetch/results/generated/prefetch_lists/
projects/legacy_gru_prefetch/results/generated/prefetch_lists/*
!projects/legacy_gru_prefetch/results/generated/prefetch_lists/.gitkeep

# ------------------------------------------------------------
# Formal LSTM/SPP local/generated outputs
# ------------------------------------------------------------
# Raw generated event CSVs stay local.
formal_NN_training/data/generated/

# Local generated Pythia config snippets. Scripts recreate these.
formal_NN_training/_cfg/

# Local scratch scripts copied from cluster experiments. Promote/rename only the
# stable versions that should become part of the shared workflow.
formal_NN_training/scripts/local_*.py
formal_NN_training/scripts/local_*.sh

# Colab upload files are allowed when intentionally added, because Colab can pull
# these directly from GitHub. Raw generated CSVs outside upload/ stay ignored.
formal_NN_training/data/upload/*
!formal_NN_training/data/upload/*/
!formal_NN_training/data/upload/*.csv.gz
!formal_NN_training/data/upload/*.events.csv.gz
!formal_NN_training/data/upload/*.events.csv.gz.part_*
!formal_NN_training/data/upload/*/*.csv.gz
!formal_NN_training/data/upload/*/*.events.csv.gz
!formal_NN_training/data/upload/*/*.events.csv.gz.part_*
!formal_NN_training/data/upload/*/lstm_events_*.csv.gz.part_*
!formal_NN_training/data/upload/*/candidate_table_*.csv.gz.part_*
!formal_NN_training/data/upload/*/spp_events_*.csv.gz.part_*

# Generated action/model/evaluation artifacts. Keep these local; they can be huge
# and are usually recreated from Colab/cluster runs.
formal_NN_training/artifacts/*.csv
formal_NN_training/artifacts/*.json
formal_NN_training/artifacts/*.pt
formal_NN_training/artifacts/*.pth
formal_NN_training/artifacts/*.gz
formal_NN_training/artifacts/full_lstm_cache_actions*
formal_NN_training/artifacts/recall_lstm_*.csv
formal_NN_training/artifacts/recall_lstm_*.json
formal_NN_training/artifacts/by_trace/
formal_NN_training/artifacts/packed/

# Ignore most generated result content, but allow curated final tables/figures
# and small replay summary CSVs. Do not commit raw logs or prefetch lists.
formal_NN_training/results/*
!formal_NN_training/results/.gitkeep

# Final paper/report-ready tables and figures.
!formal_NN_training/results/final_tables/
formal_NN_training/results/final_tables/*
!formal_NN_training/results/final_tables/*.csv
!formal_NN_training/results/final_tables/*.svg
!formal_NN_training/results/final_tables/*.md

# Per-trace replay result summaries. Keep CSV/SVG only; logs/prefetch lists stay ignored.
!formal_NN_training/results/replay_compare/
formal_NN_training/results/replay_compare/*
!formal_NN_training/results/replay_compare/accuracy_compare_*.csv
!formal_NN_training/results/replay_compare/summary_*.csv
!formal_NN_training/results/replay_compare/*.svg

# ------------------------------------------------------------
# Base-prefetcher zoo / LSTM-oracle outputs
# ------------------------------------------------------------
# Keep small curated summaries and run metadata in Git. Keep raw logs, event CSVs,
# and per-trace oracle CSVs local because they can be very large and reproducible.
!formal_NN_training/results/base_prefetcher_zoo/
formal_NN_training/results/base_prefetcher_zoo/*

# Joined final table for normal-prefetcher analysis.
!formal_NN_training/results/base_prefetcher_zoo/normal_prefetcher_metrics.csv

# Counter-level behavior audit: track summaries/RUN_INFO only.
!formal_NN_training/results/base_prefetcher_zoo/behavior_audit/
formal_NN_training/results/base_prefetcher_zoo/behavior_audit/*
!formal_NN_training/results/base_prefetcher_zoo/behavior_audit/summary.csv
!formal_NN_training/results/base_prefetcher_zoo/behavior_audit/summary_nodup.csv
!formal_NN_training/results/base_prefetcher_zoo/behavior_audit/RUN_INFO.txt
formal_NN_training/results/base_prefetcher_zoo/behavior_audit/logs/

# Demand-centric residual audit: track summaries/RUN_INFO only.
!formal_NN_training/results/base_prefetcher_zoo/residual_audit/
formal_NN_training/results/base_prefetcher_zoo/residual_audit/*
!formal_NN_training/results/base_prefetcher_zoo/residual_audit/summary.csv
!formal_NN_training/results/base_prefetcher_zoo/residual_audit/RUN_INFO.txt
formal_NN_training/results/base_prefetcher_zoo/residual_audit/events/
formal_NN_training/results/base_prefetcher_zoo/residual_audit/logs/

# LSTM oracle event tables: track summary only; keep per-trace oracle CSVs local.
!formal_NN_training/results/base_prefetcher_zoo/oracle_event_table/
formal_NN_training/results/base_prefetcher_zoo/oracle_event_table/*
!formal_NN_training/results/base_prefetcher_zoo/oracle_event_table/summary.csv
formal_NN_training/results/base_prefetcher_zoo/oracle_event_table/*.oracle.csv
formal_NN_training/results/base_prefetcher_zoo/oracle_event_table/*.oracle.csv.gz
